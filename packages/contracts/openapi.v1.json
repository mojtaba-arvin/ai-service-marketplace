  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque session token"
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "marketplace_access",
        "description": "HttpOnly access cookie. Mutating browser requests must echo marketplace_csrf in X-CSRF-Token and satisfy same-origin validation."
      },
      "refreshCookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "marketplace_refresh",
        "description": "HttpOnly refresh cookie used only by the session refresh endpoint."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "Object": {
        "type": "object",
        "additionalProperties": true
      },
      "OrderCreate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "menu_id",
          "scheduled_at",
          "country_code",
          "region_code",
          "city_code",
          "area_code"
        ],
        "properties": {
          "menu_id": {
            "type": "string",
            "minLength": 1
          },
          "scheduled_at": {
            "type": "string",
            "format": "date-time",
            "description": "Must be at least 30 minutes and no more than 90 days in the future."
          },
          "country_code": {
            "type": "string",
            "pattern": "^[A-Za-z]{2}$"
          },
          "region_code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "city_code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "area_code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      },
      "CancelOrder": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      },
      "TransitionOrder": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "to"
        ],
        "properties": {
          "to": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "description": "Target state; the server validates the role-specific state machine."
          }
        }
      },
      "OTPRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "phone"
        ],
        "properties": {
          "phone": {
            "type": "string",
            "description": "E.164 phone number."
          }
        }
      },
      "OTPVerify": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "challenge_id",
          "code"
        ],
        "properties": {
          "challenge_id": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        }
      },
      "Refresh": {
        "type": "object",
        "properties": {
          "refresh_token": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ProfessionalProfile": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "display_name"
        ],
        "properties": {
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        }
      },
      "Qualification": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category_id",
          "country_code",
          "region_code",
          "city_code",
          "area_code",
          "available_from",
          "available_until",
          "timezone"
        ],
        "properties": {
          "category_id": {
            "type": "string"
          },
          "country_code": {
            "type": "string",
            "pattern": "^[A-Za-z]{2}$"
          },
          "region_code": {
            "type": "string"
          },
          "city_code": {
            "type": "string"
          },
          "area_code": {
            "type": "string"
          },
          "available_from": {
            "type": "string",
            "format": "date-time"
          },
          "available_until": {
            "type": "string",
            "format": "date-time"
          },
          "timezone": {
            "type": "string"
          }
        }
      },
      "VerifyProvider": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category_id"
        ],
        "properties": {
          "category_id": {
            "type": "string"
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Request validation failed.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Authentication is missing or invalid.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Forbidden": {
        "description": "The authenticated actor is not authorized for this operation.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "The requested resource or route was not found.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "ServerError": {
        "description": "Unexpected server-side failure.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Conflict": {
        "description": "The request conflicts with the current resource state or idempotency record.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unprocessable": {
        "description": "The request is syntactically valid but violates domain constraints.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "RateLimited": {
        "description": "OTP or another bounded operation is rate limited.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "SessionTransport": {
        "name": "X-Session-Transport",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string",
          "enum": [
            "cookie"
          ]
        },
        "description": "When set to cookie, auth endpoints establish HttpOnly session cookies."
      },
      "CSRFToken": {
        "name": "X-CSRF-Token",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string"
        },
        "description": "Required for cookie-authenticated browser mutations; bearer clients do not need this header."
      }
    }
  }
}
