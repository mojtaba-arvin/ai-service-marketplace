{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mojtaba-arvin/ai-service-marketplace/blob/main/apps/api/internal/aiintake/suggestion.schema.json",
  "title": "Constrained marketplace intake suggestion",
  "type": "object",
  "additionalProperties": false,
  "required": ["category_id", "summary", "required_details", "confidence"],
  "properties": {
    "category_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "summary": {"type": "string", "minLength": 1, "maxLength": 1000},
    "required_details": {
      "type": "array",
      "maxItems": 10,
      "items": {"type": "string", "minLength": 1, "maxLength": 160}
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
